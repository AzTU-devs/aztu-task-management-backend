# ---- Ports exposed on the VPS host ----
# 127.0.0.1 means only a reverse proxy on this machine can reach the containers.
# Use 0.0.0.0 only if you deliberately want them reachable without TLS.
BIND_ADDRESS=127.0.0.1
API_PORT=6060
DB_EXPOSED_PORT=5433

# Shared docker network with the frontend stack. Create it once:
#   docker network create aztu-kanban-shared
SHARED_NETWORK=aztu-kanban-shared

# ---- Database ----
DB_NAME=aztu_kanban
DB_USER=aztu
DB_PASSWORD=change_this_strong_password

# ---- Security ----
# Must be at least 64 characters. Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_characters_long_000000
JWT_EXPIRATION_HOURS=24

# ---- Frontend origin (used for CORS + links inside e-mails) ----
# Exact match: https:// and http:// are different origins and a trailing slash breaks it.
CORS_ALLOWED_ORIGINS=https://kanban.eduplatform.az
FRONTEND_URL=https://kanban.eduplatform.az

# ---- E-mail (set MAIL_ENABLED=true to actually send) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aztu.edu.az
MAIL_FROM_NAME=AzTU Kanban

# ---- Bootstrap admin accounts (created on first start) ----
# Up to three administrators are created when the application boots. Slots with an
# empty e-mail or password are skipped. An account that already exists is never
# overwritten: a still-active one is promoted to ADMIN, and a DEACTIVATED one is left
# deactivated (so a restart cannot undo an offboarding). When someone leaves, deactivate
# them in the UI and clear their slot below.
#
# This file is read by Docker Compose, not by a shell: ! & and spaces are safe as-is,
# a literal $ must be doubled ($$), and quoting does NOT stop $VAR interpolation.
# Never `source` this file in bash - a value like Pa55word!& would break at the &.
ADMIN_EMAIL=admin@aztu.edu.az
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=AzTU Administrator

ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN2_FULL_NAME=AzTU Administrator

ADMIN3_EMAIL=
ADMIN3_PASSWORD=
ADMIN3_FULL_NAME=AzTU Administrator

# ---- Seed a demo platform/board/tasks on an empty database ----
SEED_DEMO_DATA=true

DDL_AUTO=update
LOG_LEVEL=INFO
